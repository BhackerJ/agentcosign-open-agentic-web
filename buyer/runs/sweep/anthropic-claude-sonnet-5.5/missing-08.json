      "body": "{\n  \"brand\": \"Demo Dock Store Assistant\",\n  \"networks\": [\n    {\n      \"name\": \"dock_store\",\n      \"front_man\": \"dock_store_assistant\",\n      \"hocon\": \"./dock_store.network.json\",\n      \"description\": \"Find a docking station that fits your laptop and displays, and place a simulated order.\",\n      \"tags\": [\n        \"agentified-website\"\n      ],\n      \"sample_queries\": [\n        \"Which dock under 150 dollars runs two 4K 60 Hz displays from a USB-C laptop?\"\n      ]\n    }\n  ],\n  \"llm_router\": {\n    \"base_url\": \"https://api.otari.ai/api/v1\",\n    \"mock\": false,\n    \"byok_router\": \"https://api.otari.ai/api/v1\"\n  },\n  \"allowed_peers\": [\n    \"http://127.0.0.1:8801\"\n  ],\n  \"peer_policy\": {\n    \"mode\": \"closed\",\n    \"deny_origins\": [],\n    \"note\": \"Calls only this store's own MCP server.\"\n  },\n  \"agent_mcp\": {\n    \"protocol\": \"nsdeploy-agent-mcp/v1\",\n    \"network\": \"dock_store\",\n    \"front_man\": \"dock_store_assistant\",\n    \"available\": false,\n    \"reason\": \"This is a static bundle; a public MCP facade requires an application host.\"\n  },\n  \"theme\": {\n    \"primary\": \"#2563eb\"\n  },\n  \"linking\": {\n    \"protocol\": \"nsdeploy-link/v1\",\n    \"exports\": [\n      {\n        \"network\": \"dock_store\",\n        \"front_man\": \"dock_store_assistant\",\n        \"aliases\": [\n          \"dock_store\",\n          \"dock_store_assistant\"\n        ],\n        \"url\": \"dock_store\"\n      }\n    ],\n    \"imports\": [],\n    \"link_updates\": {\n      \"mode\": \"browser-local\"\n    }\n  },\n  \"deployment\": {\n    \"mode\": \"static\",\n    \"self_contained_runtime\": true,\n    \"browser_mock\": false,\n    \"direct_byok\": true,\n    \"direct_mcp_requires_cors\": true,\n    \"public_mcp_facade\": false\n  }\n}\n"
